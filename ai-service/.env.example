# Run the model download command in README first. Paths are relative to ai-service.
YOLO_MODEL_PATH=.models/yolo11n.pt
YOLO_CONFIDENCE=0.35
YOLO_IMAGE_SIZE=960
YOLO_DEVICE=cpu
# Keep generated settings in the project, not in your home directory.
YOLO_CONFIG_DIR=.ultralytics
YOLO_OFFLINE=true
YOLO_AUTOINSTALL=false
MPLCONFIGDIR=.ultralytics/matplotlib
